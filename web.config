<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Canonical Finnish Services Slash" stopProcessing="true">
          <match url="^palvelut/$" />
          <action type="Redirect" url="/palvelut" redirectType="Permanent" />
        </rule>
        <rule name="Canonical English Services Slash" stopProcessing="true">
          <match url="^en/services/$" />
          <action type="Redirect" url="/en/services" redirectType="Permanent" />
        </rule>
        <rule name="Canonical Finnish Physiotherapy Slash" stopProcessing="true">
          <match url="^fysioterapia/$" />
          <action type="Redirect" url="/fysioterapia" redirectType="Permanent" />
        </rule>
        <rule name="Canonical English Physiotherapy Slash" stopProcessing="true">
          <match url="^en/physiotherapy/$" />
          <action type="Redirect" url="/en/physiotherapy" redirectType="Permanent" />
        </rule>
        <rule name="Canonical Finnish Services File" stopProcessing="true">
          <match url="^palvelut\.html$" />
          <action type="Redirect" url="/palvelut" redirectType="Permanent" />
        </rule>
        <rule name="Canonical Finnish Physiotherapy File" stopProcessing="true">
          <match url="^fysioterapia\.html$" />
          <action type="Redirect" url="/fysioterapia" redirectType="Permanent" />
        </rule>
        <rule name="Redirect Old About File" stopProcessing="true">
          <match url="^AboutUs\.html/?$" />
          <action type="Redirect" url="/tietoa-minusta.html" redirectType="Permanent" />
        </rule>
        <rule name="Redirect Old Contact File" stopProcessing="true">
          <match url="^Contact\.html/?$" />
          <action type="Redirect" url="/ota-yhteytta.html" redirectType="Permanent" />
        </rule>
        <rule name="Redirect Old Gallery File" stopProcessing="true">
          <match url="^(Gallery|gallery)\.html/?$" />
          <action type="Redirect" url="/galleria.html" redirectType="Permanent" />
        </rule>
        <rule name="Redirect Old Finnish Services" stopProcessing="true">
          <match url="^(services|Services)(\.html)?/?$" />
          <action type="Redirect" url="/palvelut" redirectType="Permanent" />
        </rule>
        <rule name="Redirect Old English Services" stopProcessing="true">
          <match url="^(En|en)/services(\.html)?/?$" />
          <conditions>
            <add input="{URL}" pattern="^/en/services$" negate="true" />
          </conditions>
          <action type="Redirect" url="/en/services" redirectType="Permanent" />
        </rule>
        <rule name="Lowercase English Prefix" stopProcessing="true">
          <match url="^En/(.+)$" />
          <action type="Redirect" url="/en/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Rewrite Finnish Services" stopProcessing="true">
          <match url="^palvelut$" />
          <action type="Rewrite" url="palvelut.html" />
        </rule>
        <rule name="Rewrite Finnish Physiotherapy" stopProcessing="true">
          <match url="^fysioterapia$" />
          <action type="Rewrite" url="fysioterapia.html" />
        </rule>
        <rule name="Rewrite English Services" stopProcessing="true">
          <match url="^en/services$" />
          <action type="Rewrite" url="En/services.html" />
        </rule>
        <rule name="Rewrite English Physiotherapy" stopProcessing="true">
          <match url="^en/physiotherapy$" />
          <action type="Rewrite" url="En/physiotherapy.html" />
        </rule>
        <rule name="Rewrite English Home" stopProcessing="true">
          <match url="^en/?$" />
          <action type="Rewrite" url="En/index.html" />
        </rule>
        <rule name="Rewrite English Pages" stopProcessing="true">
          <match url="^en/(.+)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="En/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
